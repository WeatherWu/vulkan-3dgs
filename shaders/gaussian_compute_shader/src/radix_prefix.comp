#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer IndexInBuffer {
    uint indicesIn[];
};

layout(std430, binding = 1) readonly buffer KeyInBuffer {
    uint keysIn[];
};

layout(std430, binding = 2) writeonly buffer IndexOutBuffer {
    uint indicesOut[];
};

layout(std430, binding = 3) writeonly buffer KeyOutBuffer {
    uint keysOut[];
};

layout(std430, binding = 4) readonly buffer HistogramBuffer {
    uint histograms[];
};

layout(std430, binding = 5) buffer OffsetBuffer {
    uint offsets[];
};

layout(std430, binding = 8) readonly buffer DrawIndirectBuffer {
    uint drawArgs[];
};

layout(push_constant) uniform RadixParams {
    uint count;
    uint shift;
    uint groupCount;
    uint padding;
} params;

void main() {
    uint bin = gl_GlobalInvocationID.x;
    if (bin >= 256u) {
        return;
    }

    uint count = drawArgs[1];
    uint groupCount = (count + 255u) / 256u;

    // Descending radix order: higher digit bins are placed first.
    uint base = 0;
    for (uint higherBin = bin + 1u; higherBin < 256u; ++higherBin) {
        for (uint groupIndex = 0; groupIndex < groupCount; ++groupIndex) {
            base += histograms[groupIndex * 256u + higherBin];
        }
    }

    for (uint groupIndex = 0; groupIndex < groupCount; ++groupIndex) {
        offsets[groupIndex * 256u + bin] = base;
        base += histograms[groupIndex * 256u + bin];
    }
}
