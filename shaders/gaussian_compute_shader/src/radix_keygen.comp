#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) writeonly buffer IndexOutBuffer {
    uint indicesOut[];
};

layout(std430, binding = 1) writeonly buffer KeyOutBuffer {
    uint keysOut[];
};

struct GaussianInstance {
    vec4 position;
    vec4 scale;
    vec4 rotation;
    uvec2 sh0;
    uvec2 sh1[3];
    uvec2 sh2[5];
    uvec2 sh3[7];
};

layout(std430, binding = 6) readonly buffer GaussianInstances {
    GaussianInstance instances[];
};

layout(binding = 7) uniform UniformBufferObject {
    mat4 view;
    mat4 projection;
    mat4 model;
    vec4 cameraPosition_time;
    vec4 focal;
} ubo;

layout(std430, binding = 8) buffer DrawIndirectBuffer {
    uint drawArgs[];
};

layout(push_constant) uniform RadixParams {
    uint count;
    uint shift;
    uint groupCount;
    uint padding;
} params;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= params.count) {
        return;
    }

    if (index == 0u) {
        drawArgs[0] = 4u;
        drawArgs[2] = 0u;
        drawArgs[3] = 0u;
        drawArgs[4] = 0u;
    }

    vec4 centerClip = ubo.projection * ubo.view * ubo.model * vec4(instances[index].position.xyz, 1.0);
    if (centerClip.w <= 1e-6) {
        return;
    }

    vec3 ndc = centerClip.xyz / centerClip.w;
    const float CULL_MARGIN_NDC = 2.0;
    if (ndc.x < -CULL_MARGIN_NDC || ndc.x > CULL_MARGIN_NDC ||
        ndc.y < -CULL_MARGIN_NDC || ndc.y > CULL_MARGIN_NDC ||
        ndc.z < 0.0 || ndc.z > 1.0) {
        return;
    }

    uint visibleIndex = atomicAdd(drawArgs[1], 1u);
    indicesOut[visibleIndex] = index;
    keysOut[visibleIndex] = floatBitsToUint(1.0 - ndc.z);
}
