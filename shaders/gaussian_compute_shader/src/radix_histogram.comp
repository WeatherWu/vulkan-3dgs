#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer IndexInBuffer {
    uint indicesIn[];
};

layout(std430, binding = 1) readonly buffer KeyInBuffer {
    uint keysIn[];
};

layout(std430, binding = 2) writeonly buffer IndexOutBuffer {
    uint indicesOut[];
};

layout(std430, binding = 3) writeonly buffer KeyOutBuffer {
    uint keysOut[];
};

layout(std430, binding = 4) buffer HistogramBuffer {
    uint histograms[];
};

layout(std430, binding = 5) buffer OffsetBuffer {
    uint offsets[];
};

layout(push_constant) uniform RadixParams {
    uint count;
    uint shift;
    uint groupCount;
    uint padding;
} params;

shared uint localHistogram[256];

void main() {
    uint localIndex = gl_LocalInvocationID.x;
    uint groupIndex = gl_WorkGroupID.x;
    uint globalIndex = gl_GlobalInvocationID.x;

    localHistogram[localIndex] = 0;
    barrier();

    if (globalIndex < params.count) {
        uint digit = (keysIn[globalIndex] >> params.shift) & 0xffu;
        atomicAdd(localHistogram[digit], 1);
    }

    barrier();
    histograms[groupIndex * 256u + localIndex] = localHistogram[localIndex];
}
