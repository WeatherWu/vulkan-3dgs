#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer IndexInBuffer {
    uint indicesIn[];
};

layout(std430, binding = 1) readonly buffer KeyInBuffer {
    uint keysIn[];
};

layout(std430, binding = 2) writeonly buffer IndexOutBuffer {
    uint indicesOut[];
};

layout(std430, binding = 3) writeonly buffer KeyOutBuffer {
    uint keysOut[];
};

layout(std430, binding = 4) readonly buffer HistogramBuffer {
    uint histograms[];
};

layout(std430, binding = 5) buffer OffsetBuffer {
    uint offsets[];
};

layout(std430, binding = 8) readonly buffer DrawIndirectBuffer {
    uint drawArgs[];
};

layout(push_constant) uniform RadixParams {
    uint count;
    uint shift;
    uint groupCount;
    uint padding;
} params;

void main() {
    uint localIndex = gl_LocalInvocationID.x;
    uint groupIndex = gl_WorkGroupID.x;
    uint globalIndex = gl_GlobalInvocationID.x;
    uint count = drawArgs[1];

    if (globalIndex >= count) {
        return;
    }

    uint key = keysIn[globalIndex];
    uint digit = (key >> params.shift) & 0xffu;
    uint groupStart = groupIndex * 256u;
    uint localRank = 0u;
    for (uint i = 0u; i < localIndex; ++i) {
        uint otherIndex = groupStart + i;
        if (otherIndex >= count) {
            break;
        }

        uint otherDigit = (keysIn[otherIndex] >> params.shift) & 0xffu;
        if (otherDigit == digit) {
            ++localRank;
        }
    }

    uint outputIndex = offsets[groupIndex * 256u + digit] + localRank;

    indicesOut[outputIndex] = indicesIn[globalIndex];
    keysOut[outputIndex] = key;
}
