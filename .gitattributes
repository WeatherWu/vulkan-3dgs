# Default to text normalization while keeping the repository representation LF.
* text=auto

# Source code, build configuration, documentation, and data descriptions.
*.c       text eol=lf
*.cc      text eol=lf
*.cpp     text eol=lf
*.cxx     text eol=lf
*.h       text eol=lf
*.hh      text eol=lf
*.hpp     text eol=lf
*.hxx     text eol=lf
*.inl     text eol=lf
*.cmake   text eol=lf
CMakeLists.txt text eol=lf
*.slang   text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
.clang-format text eol=lf
.clang-tidy   text eol=lf
.gitignore    text eol=lf
.gitmodules   text eol=lf

# Native Windows command scripts require CRLF for broad compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets and generated artifacts must never be normalized.
*.bmp  -text
*.gif  -text
*.ico  -text
*.jpeg -text
*.jpg  -text
*.ktx  -text
*.ktx2 -text
*.png  -text
*.spv  -text
*.ttc  -text
*.ttf  -text
*.obj  -text
*.ply  -text
*.exe  -text
*.dll  -text
*.lib  -text
